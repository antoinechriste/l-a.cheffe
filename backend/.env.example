# Copy to .env and fill values
PORT=4000
JWT_SECRET=your_jwt_secret_here
# Optional: Hugging Face token for LLM (recommended for better replies)
HUGGINGFACEHUB_API_TOKEN=
# Optional: Spoonacular or Edamam API key for recipes
SPOONACULAR_API_KEY=
# If you want to use Edamam instead, set EDAMAM_APP_ID and EDAMAM_APP_KEY
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
